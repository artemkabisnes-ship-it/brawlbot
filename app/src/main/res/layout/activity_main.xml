<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:padding="24dp"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <TextView android:text="Персонаж:" android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <Spinner android:id="@+id/spinnerChar"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>

    <TextView android:text="Целевые трофеи:" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_marginTop="16dp"/>
    <EditText android:id="@+id/editTarget" android:inputType="number"
        android:text="500" android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <Button android:id="@+id/btnStart" android:text="Запустить бота"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="24dp"/>
</LinearLayout>
